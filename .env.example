# ============ Frontend (Vite) ============
# Optional: your OWN Google AI Studio (Gemini) key for local dev with direct
# calls. Production uses the SERVER-side key — never ship keys in the client.
VITE_GEMINI_KEY=

# ============ Backend (server.mjs + ai-router.mjs) ============
# REQUIRED for billing: Telegram bot token (@BotFather)
BOT_TOKEN=
# REQUIRED: shared secret for the Telegram webhook (set via setWebhook secret_token)
WEBHOOK_SECRET=
# Public URL of the Mini App (used in bot buttons and LiqPay callbacks)
APP_URL=https://tempo-lifeos.pplx.app

# Gemini API key for the AI router (server-side only).
# Get one free at https://aistudio.google.com/apikey
# If empty, the embedded pilot key is used (rotate it as soon as possible).
GEMINI_API_KEY=

# Admin panel: username is always "Mister"; set the password (no default).
# Without this env the admin account does not exist (fail closed).
ADMIN_PASS=
# Telegram username of the owner (auto-admin when they open the Mini App)
ADMIN_TG=neggshka

# OPTIONAL: LiqPay automatic card checkout (liqpay.ua merchant account).
# Without these keys, card payments fall back to manual owner verification.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# ============ Roadmap (not required) ============
SUPABASE_URL=
SUPABASE_ANON_KEY=
